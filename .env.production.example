# BUFF V14 PRODUCTION EXAMPLE — never commit real secrets.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=buff_prod
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_DATABASE=buff_v126
APP_ENV=production
APP_DEBUG=0
APP_ENCRYPTION_KEY=REPLACE_WITH_64_PLUS_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_TTL_SECONDS=604800
COOKIE_SECURE=1
PUBLIC_BASE_URL=https://buff.example.com
NODE_PUBLIC_URL=https://realtime.buff.example.com
REALTIME_PUBLIC_URL=wss://realtime.buff.example.com/realtime
PORT=3000

REDIS_ENABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=buff:

# r2 example. For AWS S3 use STORAGE_PROVIDER=s3 and the AWS endpoint/region.
# For MinIO use STORAGE_PROVIDER=minio and OBJECT_STORAGE_PATH_STYLE=1.
STORAGE_PROVIDER=r2
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=buff-media
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.buff.example.com
OBJECT_STORAGE_PATH_STYLE=1

FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_PRESET=veryfast
WORKER_POLL_MS=1000
JOB_MAX_ATTEMPTS=5

AI_MODERATION_ENABLED=1
AI_MODERATION_WEBHOOK=https://moderation.example.com/v1/analyze
AI_MODERATION_API_KEY=REPLACE_ME
EMAIL_WEBHOOK_URL=https://mailer.example.com/v1/send
EMAIL_WEBHOOK_TOKEN=REPLACE_ME
DAILY_LOYALTY_POINTS=100
CREATOR_COIN_TRY_RATE=0.01

PAYMENT_PROVIDER=paytr
PAYTR_MERCHANT_ID=REPLACE_ME
PAYTR_MERCHANT_KEY=REPLACE_ME
PAYTR_MERCHANT_SALT=REPLACE_ME
PAYTR_TEST_MODE=0
PAYTR_DEBUG_ON=0
PAYTR_TEST_USER_IP=

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
